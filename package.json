{
  "name": "minhduc-prototype",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir .ssr && node scripts/prerender.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node tests/jobs-logic.mjs",
    "test:seo": "node tests/seo-output.mjs",
    "test:hydration": "node tests/hydration.mjs",
    "test:sprint": "node tests/jobs-sprint1.mjs && node tests/admin-demo.mjs && node tests/admin-interaction.mjs && node tests/education-validation.mjs",
    "audit:i18n": "node scripts/audit-i18n.mjs",
    "test:review": "node tests/reviewer-flows.mjs && node tests/reviewer-locales.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^31.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
